@model IEnumerable<VotaFacil.Domain.Entidades.EleicaoModel>
@{
    ViewBag.Title = "Resultado da Votação";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Resultado da Votação</h2>
    <div class="form-group">
        <label for="eleicaoSelect">Selecione a Eleição:</label>
        <select id="eleicaoSelect" class="form-control" onchange="loadCandidatos(this.value)">
            <option value="">Selecione uma eleição</option>
            @foreach (var eleicao in Model)
            {
                var statusClass = eleicao.Status == "Em Andamento" ? "text-warning" : "text-success";
                <option value="@eleicao.Id" class="@statusClass">@eleicao.Nome (@eleicao.Status)</option>
            }
        </select>
    </div>

    <div id="candidatosContainer" class="row">
        <!-- Os candidatos serão carregados aqui -->
    </div>
</div>

<!-- Adicione o link para o Bootstrap no seu layout -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<script>
    function loadCandidatos(eleicaoId) {
        if (eleicaoId) {
            $.get('/Resultado/GetCandidatos', { eleicaoId: eleicaoId }, function (data) {
                $('#candidatosContainer').html(data);
            });
        } else {
            $('#candidatosContainer').html('');
        }
    }
</script>