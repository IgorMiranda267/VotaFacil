@model IEnumerable<VotaFacil.Apllication.DTO.CandidatoDTO>

@{
    ViewBag.Title = "Escolha Candidato";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Escolha um Candidato</h2>
    <div class="row">
        @foreach (var candidato in Model)

        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <img src="@(candidato.FotoPath ?? Url.Content("~/images/default.jpg"))" class="card-img-top" alt="Foto do Candidato">
                    <div class="card-body">
                        <h5 class="card-title">@candidato.Nome</h5>
                        <p class="card-text">@candidato.Descricao</p>
                        <form asp-action="Votar" method="post">
                            <input type="hidden" name="candidatoId" value="@candidato.Id" />
                            <input type="hidden" name="eleicaoId" value="@ViewBag.EleicaoId" />
                            <button type="submit" class="btn btn-primary">Votar</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>