@model IEnumerable<VotaFacil.Apllication.DTO.CandidatoDTO>

@{
    ViewBag.Title = "EscolhaCandidato";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Votação</h2>
    <div class="row">
        @foreach (var candidato in Model)

        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <img src="~/images/@(candidato.Foto != null ? candidato.Foto.FileName : "default.jpg")" class="card-img-top" alt="Foto do Candidato">
                    <div class="card-body">
                        <h5 class="card-title">@candidato.Nome</h5>
                        <p class="card-text">@candidato.Descricao</p>
                        <a href="#" class="btn btn-primary">Votar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Adicione o link para o Bootstrap no seu layout -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
